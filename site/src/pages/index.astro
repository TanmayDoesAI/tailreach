---
import '../styles/landing.css';

const site = 'https://tailreach.tanmaylabs.me';
const title = 'tailreach: your Mac, in any browser';
const description =
  'Control your Mac from any browser, or turn an old laptop or tablet into a second screen for it. Just a browser and Tailscale. Free and open source.';
const repo = 'https://github.com/TanmayDoesAI/tailreach';

const points = [
  {
    title: 'Control it from anywhere',
    body: 'A live 60 fps screen in the browser, with touch, trackpad gestures and real keyboard shortcuts. Unlock the Mac from its lock screen too.',
  },
  {
    title: 'Any screen is a second monitor',
    body: 'Open it on a laptop or tablet and click Start: the Mac gets a real extra display. Drag windows onto it like a plugged-in monitor.',
  },
  {
    title: 'Light on the other end',
    body: 'The Mac does the encoding; the browser just plays video. An old laptop, a Chromebook or a cheap tablet is plenty. No app, no GPU.',
  },
];

// '' = not verified, shown as a dot. Corrections welcome.
const cols = ['Viewer is just a browser', 'Second monitor', 'Open source', 'Free'];
const rows = [
  { name: 'tailreach', cells: ['Yes', 'Yes', 'Yes', 'Yes'], us: true },
  { name: 'Chrome Remote Desktop', cells: ['Desktop only', 'No', 'No', 'Yes'] },
  { name: 'Parsec', cells: ['', '', 'No', 'Personal use'] },
  { name: 'RustDesk', cells: ['', '', 'Yes', 'Yes'] },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site + '/'} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0e0e0e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site + '/'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={site + '/og.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="nav wrap">
      <a class="brand" href="/"><img src="/favicon.png" alt="" width="24" height="24" />tailreach</a>
      <nav>
        <a href="/docs/getting-started/">Docs</a>
        <a href={repo}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <h1>Your Mac, in any browser.</h1>
        <p class="lede">
          Control it from your phone, or turn that old laptop or tablet into a second screen.
          Nothing to install on it but Tailscale: no app, no server, no port forwarding.
        </p>
        <div class="cta">
          <a class="btn primary" href="/docs/getting-started/">Get started</a>
          <a class="btn" href={repo}>GitHub</a>
        </div>
      </section>

      <section class="wrap demo">
        <video autoplay muted loop playsinline preload="metadata" poster="/demo-poster.jpg" width="1600" height="900"
          aria-label="tailreach demo: a Mac controlled from a phone, then an old laptop used as its second screen">
          <source src="/demo.webm" type='video/webm; codecs="av01.0.08M.08"' />
          <source src="/demo.mp4" type="video/mp4" />
        </video>
      </section>

      <section class="wrap points">
        {points.map((p) => (
          <div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </section>

      <section class="wrap narrow" id="install">
        <h2>Install on the Mac</h2>
        <pre><code><span class="p">$</span> brew install tanmaydoesai/tailreach/tailreach
<span class="p">$</span> tailreach setup</code></pre>
        <p class="sub">Setup ends with <code>tailreach doctor</code>, which tells you what's left: approve the Tailscale sign-in, pick a password, allow two permissions. Then open the link on any device on your tailnet. <a href="/docs/getting-started/">Full guide →</a></p>
      </section>

      <section class="wrap narrow" id="compare">
        <h2>Why not something else?</h2>
        <p class="sub">They're good tools. tailreach is for when you want nothing but a browser on the other end, on your own private network.</p>
        <div class="table">
          <table>
            <thead>
              <tr><th></th>{cols.map((c) => <th scope="col">{c}</th>)}</tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr class={r.us ? 'us' : ''}>
                  <th scope="row">{r.name}</th>
                  {r.cells.map((c) => <td class={c === 'Yes' ? 'yes' : c ? 'no' : 'na'}>{c || '·'}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fine">A dot means we haven't checked. Spot a mistake? <a href={repo + '/issues'}>Open an issue</a>.</p>
      </section>
    </main>

    <footer>
      <div class="wrap foot">
        <a class="brand" href="/"><img src="/favicon.png" alt="" width="20" height="20" />tailreach</a>
        <nav>
          <a href="/docs/getting-started/">Docs</a>
          <a href={repo}>GitHub</a>
          <a href={repo + '/blob/main/LICENSE'}>Apache-2.0</a>
        </nav>
        <p class="fine">Made by <a href="https://github.com/TanmayDoesAI">Tanmay</a>. Not affiliated with Tailscale Inc.</p>
      </div>
    </footer>
  </body>
</html>
